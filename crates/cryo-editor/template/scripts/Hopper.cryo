// A friendly creature with a huge jump. Hit it with the cap to capture it:
// while captured, the Player script drives it.
script Hopper {
    var captured = false
    var cooldown = 0
    var hop_timer = 1.5

    on update(dt) {
        cooldown = max(cooldown - dt, 0)
        if captured {
            return
        }
        // idle: a little hop now and then
        hop_timer -= dt
        if hop_timer <= 0 and self.grounded {
            hop_timer = 2.2
            var v = self.velocity
            v.y = 5
            self.velocity = v
        }
    }

    on collide(other, normal) {
        if other.name == "Cap" and not captured and cooldown <= 0 {
            let player = scene.find("Player")
            if player != nil {
                captured = true
                self.color = vec3(1, 0.85, 0.3)
                other.send("vanish")
                player.send("captured", self)
            }
        }
    }

    on released() {
        captured = false
        cooldown = 1.5
        self.color = vec3(0.45, 0.85, 0.5)
    }
}
