// Controla o jogador: WASD (ou setas) para andar, Espaço para pular.
script Jogador {
    prop velocidade: num = 6
    prop forca_pulo: num = 7.5
    var moedas = 0

    on start() {
        hud("Moedas: 0   |   WASD anda, Espaço pula")
    }

    on update(dt) {
        var v = self.velocity
        v.x = input.axis("horizontal") * velocidade
        v.z = -input.axis("vertical") * velocidade

        if input.pressed("space") and self.grounded {
            v.y = forca_pulo
            audio.play("sounds/pulo.wav", 0.6)
        }
        self.velocity = v

        // Caiu do mapa? Volta para o início.
        if self.position.y < -10 {
            self.position = vec3(0, 2, 0)
            self.velocity = vec3(0)
        }
    }

    // Evento personalizado, enviado pelo script Moeda com `send("pegou_moeda")`.
    on pegou_moeda() {
        moedas += 1
        hud("Moedas: " + moedas)
        log("moeda coletada, total =", moedas)
    }
}
