// Kip, the hero of the example platformer.
//
// Moves relative to the camera and knows the classic 3D-platformer tricks:
// triple jump, backflip, long jump, ground pound, wall jump, cap throw,
// cap bounce and "capturing" a creature with the cap.
script Player {
    prop run_speed: num = 7
    prop jump_speed: num = 10
    prop max_health: num = 3

    var health = 3
    var coins = 0
    var shards = 0
    var total_shards = 0
    var mode = "normal"        // normal | long | pound | captured
    var jump_chain = 0         // 0, 1, 2 -> single, double, triple jump
    var since_ground = 0       // seconds since we last stood on something
    var since_land = 10        // seconds on the ground since the last landing
    var was_grounded = false
    var pound_timer = 0
    var pound_landed = 10
    var wall_timer = 0
    var wall_lock = 0
    var wall_normal = vec3(0)
    var hurt_timer = 0
    var spawn = vec3(0, 1.2, 4)
    var cap_out = false
    var host: entity = nil
    var facing = 0
    var hint = ""
    var hint_timer = 0
    var won = false

    on start() {
        health = max_health
        spawn = self.position
        for e in scene.all() {
            if e.name.contains("Shard") {
                total_shards += 1
            }
        }
        show_hint("WASD: move   Space: jump   F or click: throw cap   Arrows / right-drag: camera")
    }

    // ---------------------------------------------------------------- helpers

    // Direction the player is pushing, relative to where the camera looks.
    fn move_input() -> vec3 {
        var x = 0
        var z = 0
        if input.down("d") { x += 1 }
        if input.down("a") { x -= 1 }
        if input.down("w") { z += 1 }
        if input.down("s") { z -= 1 }
        if x == 0 and z == 0 {
            return vec3(0)
        }
        var forward = vec3(0, 0, -1)
        let cam = scene.find("Camera")
        if cam != nil {
            var f = cam.forward
            f.y = 0
            if length(f) > 0.001 {
                forward = normalize(f)
            }
        }
        let right = cross(forward, vec3(0, 1, 0))
        return normalize(forward * z + right * x)
    }

    fn facing_dir() -> vec3 {
        let a = facing * PI / 180
        return vec3(-sin(a), 0, -cos(a))
    }

    fn throw_pressed() -> bool {
        return input.pressed("f") or input.pressed("mouse_left")
    }

    fn show_hint(message: text) {
        hint = message
        hint_timer = 7
    }

    fn draw_hud() {
        var line = "HP " + health + "/" + max_health + "    Coins " + coins + "    Shards " + shards + "/" + total_shards
        if hint_timer > 0 {
            line = line + "\n" + hint
        }
        hud(line)
    }

    fn set_hat(shown: bool) {
        let hat = scene.find("KipHat")
        if hat != nil {
            hat.visible = shown
        }
    }

    fn respawn() {
        self.position = spawn
        self.velocity = vec3(0)
        mode = "normal"
        hurt_timer = 1.5
        if health <= 0 {
            health = max_health
        }
    }

    // ----------------------------------------------------------------- update

    on update(dt) {
        hurt_timer = max(hurt_timer - dt, 0)
        hint_timer = max(hint_timer - dt, 0)
        pound_landed += dt
        wall_timer = max(wall_timer - dt, 0)
        wall_lock = max(wall_lock - dt, 0)

        if mode == "captured" {
            control_host(dt)
            draw_hud()
            return
        }

        let grounded = self.grounded
        var v = self.velocity
        let dir = move_input()
        let crouch = input.down("shift")

        // --- landing ---
        if grounded {
            if not was_grounded {
                since_land = 0
                if mode == "pound" {
                    pound_landed = 0
                    audio.play("sounds/pound.wav", 0.7)
                }
                mode = "normal"
            }
            since_ground = 0
            since_land += dt
            if since_land > 0.3 {
                jump_chain = 0
            }
        } else {
            since_ground += dt
        }
        was_grounded = grounded

        // --- running ---
        if mode == "normal" and hurt_timer < 1.0 and wall_lock <= 0 {
            var speed = run_speed
            var accel = 14
            if crouch and grounded { speed = run_speed * 0.4 }
            if not grounded { accel = 6 }
            let k = clamp(accel * dt, 0, 1)
            v.x = lerp(v.x, dir.x * speed, k)
            v.z = lerp(v.z, dir.z * speed, k)
        }
        if mode == "long" {
            v.x += dir.x * 5 * dt
            v.z += dir.z * 5 * dt
        }

        // --- jumping ---
        if input.pressed("space") {
            if mode == "normal" and since_ground < 0.12 {
                let moving = length(vec3(v.x, 0, v.z)) > 3
                if crouch and moving {
                    // long jump: low and far
                    mode = "long"
                    let d = facing_dir()
                    v = d * 13
                    v.y = 7.5
                } else if crouch {
                    // backflip: straight up, higher than a normal jump
                    v.y = 13.5
                    jump_chain = 0
                } else if pound_landed < 0.25 {
                    // jumping right after a ground pound goes extra high
                    v.y = 13.5
                } else {
                    var power = jump_speed
                    if jump_chain == 1 and moving { power = 11.5 }
                    if jump_chain == 2 and moving { power = 14 }
                    v.y = power
                    jump_chain = (jump_chain + 1) % 3
                }
                since_ground = 1
                audio.play("sounds/jump.wav", 0.5)
            } else if wall_timer > 0 and not grounded {
                // wall jump: kick away from the wall
                v = wall_normal * 7.5
                v.y = 10.5
                wall_timer = 0
                wall_lock = 0.22
                mode = "normal"
                audio.play("sounds/jump.wav", 0.5)
            }
        }
        // releasing Space early makes a shorter hop
        if input.released("space") and v.y > 4 and mode == "normal" and since_ground >= 1 and since_ground < 2 {
            v.y = v.y * 0.55
        }

        // --- ground pound ---
        if input.pressed("shift") and not grounded and mode != "pound" and since_ground > 0.15 {
            mode = "pound"
            pound_timer = 0.2
        }
        if mode == "pound" {
            pound_timer -= dt
            if pound_timer > 0 {
                v = vec3(0)
            } else {
                v = vec3(0, -26, 0)
            }
        }

        // --- wall slide ---
        if wall_timer > 0 and not grounded and v.y < -3 and mode == "normal" {
            v.y = -3
        }

        self.velocity = v

        // --- cap ---
        if throw_pressed() and not cap_out and mode != "pound" {
            let cap = scene.find("Cap")
            if cap != nil {
                cap.send("throw", self.position + vec3(0, 0.3, 0), facing_dir())
                cap_out = true
                set_hat(false)
            }
        }

        // --- facing and pose ---
        if length(dir) > 0.1 {
            let target = atan2(-dir.x, -dir.z) * 180 / PI
            let diff = (target - facing + 540) % 360 - 180
            facing += diff * clamp(16 * dt, 0, 1)
        }
        let model = scene.find("KipModel")
        if model != nil {
            model.rotation = vec3(0, facing, 0)
            if crouch and grounded {
                model.scale = vec3(1.25, 0.44, 1.25)
                model.position = vec3(0, -0.15, 0)
            } else {
                model.scale = vec3(1.25, 0.625, 1.25)
                model.position = vec3(0)
            }
        }

        // --- falling off the island ---
        if self.position.y < -5 {
            health -= 1
            audio.play("sounds/hurt.wav", 0.6)
            respawn()
        }

        draw_hud()
    }

    // While capturing a creature we drive it instead of Kip.
    fn control_host(dt) {
        if host == nil or not host.exists() {
            release()
            return
        }
        let dir = move_input()
        var v = host.velocity
        let k = clamp(10 * dt, 0, 1)
        v.x = lerp(v.x, dir.x * 5, k)
        v.z = lerp(v.z, dir.z * 5, k)
        if input.pressed("space") and host.grounded {
            v.y = 19
            audio.play("sounds/bounce.wav", 0.6)
        }
        host.velocity = v
        self.position = host.position + vec3(0, 0.2, 0)
        self.velocity = vec3(0)
        if throw_pressed() or input.pressed("e") {
            release()
        }
    }

    fn release() {
        mode = "normal"
        self.visible = true
        if host != nil and host.exists() {
            self.position = host.position + vec3(0, 1.7, 0)
            host.send("released")
        }
        self.velocity = vec3(0, 10, 0)
        host = nil
        cap_out = false
        since_ground = 2
        set_hat(true)
    }

    // ----------------------------------------------------------------- events

    on collide(other, normal) {
        if mode == "captured" or other.trigger {
            return
        }
        // touching a wall while in the air: remember it for sliding and wall jumps
        if abs(normal.y) < 0.3 and not self.grounded and wall_lock <= 0 {
            wall_normal = normal
            wall_timer = 0.25
        }
    }

    on captured(target) {
        mode = "captured"
        host = target
        cap_out = true
        self.visible = false
        audio.play("sounds/capture.wav", 0.7)
        show_hint("Captured! Space: super jump   E or F: leave")
    }

    on cap_home() {
        if mode != "captured" {
            cap_out = false
            set_hat(true)
        }
    }

    on cap_bounce() {
        var v = self.velocity
        v.y = 11.5
        self.velocity = v
        mode = "normal"
        jump_chain = 0
        since_ground = 2
        audio.play("sounds/bounce.wav", 0.6)
    }

    on bounce(power) {
        var v = self.velocity
        v.y = power
        self.velocity = v
        mode = "normal"
        since_ground = 2
        audio.play("sounds/bounce.wav", 0.7)
    }

    on stomp() {
        var v = self.velocity
        v.y = 9
        self.velocity = v
        mode = "normal"
        since_ground = 2
    }

    on hurt(from) {
        if hurt_timer > 0 or mode == "captured" {
            return
        }
        health -= 1
        hurt_timer = 1.3
        audio.play("sounds/hurt.wav", 0.6)
        if health <= 0 {
            respawn()
            return
        }
        var away = self.position - from
        away.y = 0
        if length(away) < 0.01 {
            away = vec3(0, 0, 1)
        }
        var v = normalize(away) * 6
        v.y = 7
        self.velocity = v
        mode = "normal"
    }

    on coin() {
        coins += 1
        audio.play("sounds/coin.wav", 0.6)
    }

    on shard() {
        shards += 1
        audio.play("sounds/shard.wav", 0.8)
        if shards >= total_shards and not won {
            won = true
            hint = "You found every Frost Shard. Thanks for playing!"
            hint_timer = 600
        } else {
            show_hint("Frost Shard " + shards + " of " + total_shards + "!")
        }
    }

    on checkpoint(position) {
        spawn = position + vec3(0, 1.2, 0)
        health = max_health
        audio.play("sounds/checkpoint.wav", 0.6)
        show_hint("Checkpoint reached")
    }

    on hint(message) {
        if not won {
            show_hint(message)
        }
    }
}
