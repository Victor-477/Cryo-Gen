// Câmera livre (estilo espectador): WASD move, Q/E desce/sobe,
// botão direito do mouse + arrastar olha em volta, Shift acelera.
script CameraLivre {
    prop velocidade: num = 8
    prop sensibilidade: num = 0.2

    on update(dt) {
        if input.down("mouse_right") {
            var r = self.rotation
            r.y -= input.mouse_dx * sensibilidade
            r.x = clamp(r.x - input.mouse_dy * sensibilidade, -89, 89)
            self.rotation = r
        }
        var v = velocidade
        if input.down("shift") {
            v = v * 3
        }
        var mover = self.forward * input.axis("vertical") + self.right * input.axis("horizontal")
        if input.down("e") {
            mover.y += 1
        }
        if input.down("q") {
            mover.y -= 1
        }
        self.translate(mover * v * dt)
    }
}
