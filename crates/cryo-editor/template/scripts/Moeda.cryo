// Moeda que gira, flutua e some quando o jogador encosta.
script Moeda {
    prop giro: num = 140
    var altura = 0

    on start() {
        altura = self.position.y
    }

    on update(dt) {
        self.rotate(vec3(0, giro * dt, 0))
        self.position.y = altura + sin(time.total * 3) * 0.15
    }

    on collide(outro: entity) {
        if outro.name == "Jogador" {
            outro.send("pegou_moeda")
            audio.play("sounds/moeda.wav")
            self.destroy()
        }
    }
}
