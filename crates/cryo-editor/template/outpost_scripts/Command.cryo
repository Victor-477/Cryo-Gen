// Mission control: counts the drones of each sector, opens the way, tracks the objective.
script Command {
    var left = {}
    var nodes = 3
    var goal = "Clear the yard"

    on start() {
        audio.music("sounds/ambience.wav", 0.4)
        banner("OUTPOST KESTREL", 3.5)
    }

    on enemy_spawned(area) {
        left[area] = left.get(area, 0) + 1
    }

    on enemy_down(area) {
        left[area] = left.get(area, 1) - 1
        if left[area] <= 0 {
            emit("area_clear", area)
        }
    }

    on area_clear(area) {
        match area {
            "yard" => {
                goal = "Door open. Sweep the warehouse"
                banner("SECTOR CLEAR", 2)
            }
            "hall" => {
                goal = "Destroy the three coolant nodes"
                banner("REACTOR ACCESS GRANTED", 2.5)
            }
        }
    }

    on node_down() {
        nodes -= 1
        if nodes <= 0 {
            goal = "Reactor offline. Mission complete"
            audio.stop_music()
            audio.play("sounds/win.wav", 0.9)
            banner("OUTPOST SECURED", 8)
            emit("core_down")
        } else if nodes > 0 {
            goal = "Destroy the coolant nodes: " + nodes + " left"
        }
    }

    on update(dt) {
        hud(goal + "\nAmmo: " + global.ammo)
    }
}
