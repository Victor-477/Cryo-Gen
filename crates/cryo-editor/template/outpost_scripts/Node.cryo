// A coolant node of the reactor. Shoot it until it bursts.
script Node {
    prop max_health: num = 130
    var health = 130
    var glow = 0

    on start() {
        health = max_health
    }

    on hit(amount, from) {
        health -= amount
        glow = 0.08
        self.scale = vec3(1.08)
        if health <= 0 {
            fx.burst(self.position + vec3(0, 1, 0), "explosion", 60)
            fx.burst(self.position + vec3(0, 1, 0), "magic", 40)
            audio.play_at("sounds/boom.wav", self.position, 1)
            emit("node_down")
            self.destroy()
        }
    }

    on update(dt) {
        if glow > 0 {
            glow -= dt
            if glow <= 0 {
                self.scale = vec3(1)
            }
        }
    }
}
