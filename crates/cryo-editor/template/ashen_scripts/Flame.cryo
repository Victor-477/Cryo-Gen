// A torch flame that flickers.
script Flame {
    var base = vec3(1)
    on start() {
        base = self.scale
        every(0.2, "spark")
    }
    on spark() {
        fx.burst(self.position + vec3(0, 0.2, 0), "embers", 1)
    }
    on update(dt) {
        self.scale = base * (0.85 + random() * 0.3)
    }
}
