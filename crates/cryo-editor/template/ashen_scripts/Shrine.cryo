// A checkpoint: touching it heals the knight, who returns here after falling in battle.
script Shrine {
    var lit = false
    on touch_start(other) {
        if other.tag == "player" {
            other.send("checkpoint", self.position + vec3(0, 1, 2.5))
            if not lit {
                lit = true
                fx.burst(self.position + vec3(0, 1.8, 0), "magic", 60)
                audio.play("sounds/heal.wav", 0.8)
                banner("SHRINE KINDLED", 1.8)
                // the first shrine leaves an Ember Ring in the knight's bag
                if not inventory.has("ember_ring") {
                    inventory.add("ember_ring")
                }
            }
        }
    }
}
